{
  "openapi": "3.1.0",
  "info": {
    "title": "Indonesia Business Agent Skills REST API",
    "version": "6.20.0",
    "description": "Production-grade, deterministic REST API microservice for Indonesian tax, labor, finance, commercial, and legal calculations. Zero external dependencies.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "contact": {
      "name": "adamriofc",
      "url": "https://github.com/adamriofc/indonesia-business-agent-skills"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local standalone microservice instance"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Healthcheck & System Metadata",
        "description": "Returns microservice operational status, runtime version, and endpoint count.",
        "responses": {
          "200": {
            "description": "Service is healthy and operational",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": { "type": "string" },
                    "version": { "type": "string" },
                    "status": { "type": "string", "example": "UP" },
                    "runtime": { "type": "string" },
                    "uptimeSeconds": { "type": "number" },
                    "availableEndpoints": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/calc/pph21": {
      "post": {
        "summary": "Calculate PPh 21 TER Monthly Tax",
        "description": "Computes exact employee PPh 21 monthly tax withholding under PP No. 58/2023 & PMK No. 168/2023.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["grossSalary", "ptkpStatus"],
                "properties": {
                  "grossSalary": { "type": "number", "example": 10000000, "description": "Gross monthly salary in IDR" },
                  "ptkpStatus": { "type": "string", "example": "TK/0", "description": "PTKP code (TK/0..K/3)" },
                  "hasNpwp": { "type": "boolean", "default": true, "description": "Whether employee has valid NPWP/NIK" },
                  "dateStr": { "type": "string", "example": "2026-03-01", "description": "Effective date window" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Calculation successful" },
          "400": { "description": "Invalid input parameters" }
        }
      }
    },
    "/api/v1/calc/pph21-december": {
      "post": {
        "summary": "PPh 21 December Annual Reconciliation & Overpayment Refund",
        "description": "Evaluates full year Article 17 progressive tax and calculates employee restitution if overpaid per PMK 168/2023.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["annualGrossIncome", "ptkpStatus", "janToNovTaxWithheld"],
                "properties": {
                  "annualGrossIncome": { "type": "number", "example": 80000000 },
                  "ptkpStatus": { "type": "string", "example": "TK/0" },
                  "janToNovTaxWithheld": { "type": "number", "example": 5000000 },
                  "monthlyJhtEmployeeDeduction": { "type": "number", "example": 100000 },
                  "hasNpwp": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Reconciliation successful" },
          "400": { "description": "Invalid input" }
        }
      }
    },
    "/api/v1/calc/phk": {
      "post": {
        "summary": "Calculate Statutory PHK Severance Payout",
        "description": "Computes Uang Pesangon (UP), UPMK, UPH, and Uang Pisah per PP No. 35/2021.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["monthlyWage", "tenureYears", "reasonKey"],
                "properties": {
                  "monthlyWage": { "type": "number", "example": 10000000 },
                  "tenureYears": { "type": "number", "example": 5 },
                  "reasonKey": { "type": "string", "example": "resignation" },
                  "remainingLeaveDays": { "type": "number", "default": 0 },
                  "uangPisahAmount": { "type": "number", "default": 0 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Severance calculation successful" },
          "400": { "description": "Invalid reason or negative numbers" }
        }
      }
    },
    "/api/v1/calc/overtime": {
      "post": {
        "summary": "Calculate Statutory Overtime Payout (PP 35/2021)",
        "description": "Computes exact overtime pay using statutory 1/173 hourly multiplier across workdays, weekly rest, and public holidays.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["monthlyWage", "hours"],
                "properties": {
                  "monthlyWage": { "type": "number", "example": 6000000 },
                  "fixedAllowance": { "type": "number", "default": 0 },
                  "hours": { "type": "number", "example": 4 },
                  "dayType": { "type": "string", "enum": ["WORKDAY", "WEEKLY_REST_5_DAYS", "WEEKLY_REST_6_DAYS", "PUBLIC_HOLIDAY"], "default": "WORKDAY" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Overtime calculation successful" },
          "400": { "description": "Invalid input" }
        }
      }
    },
    "/api/v1/calc/bpjs": {
      "post": {
        "summary": "Calculate BPJS Ketenagakerjaan & Kesehatan",
        "description": "Computes employer and employee statutory contributions with official wage caps.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["monthlySalary"],
                "properties": {
                  "monthlySalary": { "type": "number", "example": 10000000 },
                  "riskLevel": { "type": "string", "default": "low" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "BPJS calculation successful" }
        }
      }
    },
    "/api/v1/calc/ppn": {
      "post": {
        "summary": "Calculate PPN 12%, Besaran Tertentu & PPnBM",
        "description": "Calculates standard 12% PPN, Besaran Tertentu 1.2% (logistics/travel per PMK 71/2022 & PMK 131/2024), DPP Nilai Lain, and PPnBM luxury tax.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sellingPriceOrDpp"],
                "properties": {
                  "sellingPriceOrDpp": { "type": "number", "example": 100000000 },
                  "transactionType": { "type": "string", "default": "standard" },
                  "ppnbmRatePercent": { "type": "number", "default": 0 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tax calculation successful" }
        }
      }
    },
    "/api/v1/audit/contract-risk": {
      "post": {
        "summary": "Audit Contract Risk & Clause Traps",
        "description": "Scans commercial agreement text and computes a Contract Risk Score (0-100) with Pasal 1266 KUHPerdata and liability cap checks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["contractText"],
                "properties": {
                  "contractText": { "type": "string", "description": "Full contract agreement text" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Risk audit completed" }
        }
      }
    },
    "/api/v1/route/kbli": {
      "post": {
        "summary": "Resolve KBLI Code to Business Archetype",
        "description": "Maps 5-digit KBLI 2020 codes to canonical Business Archetypes and operational focus.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["kbliCode"],
                "properties": {
                  "kbliCode": { "type": "string", "example": "70209" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "KBLI resolved" }
        }
      }
    },
    "/api/v1/strategy/quantitative-swot": {
      "post": {
        "summary": "Quantitative SWOT & TOWS Matrix Evaluation",
        "description": "Evaluates internal (IFE) and external (EFE) strategic position, vector coordinates (ΔX, ΔY), posture quadrant, and TOWS cross-impact ranking.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["internal", "external"],
                "properties": {
                  "internal": { "type": "object" },
                  "external": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Quantitative SWOT evaluation successful" },
          "400": { "description": "Invalid input parameters" }
        }
      }
    },
    "/api/v1/strategy/balanced-scorecard": {
      "post": {
        "summary": "Balanced Scorecard Evaluation & Strategy Map Broken Link Audit",
        "description": "Evaluates multi-perspective corporate performance with Min/Max polarity, statutory 120% cap ratio (KMK 467/2014), and causal broken-link detection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["perspectives"],
                "properties": {
                  "sector": { "type": "string", "enum": ["PRIVATE_COMMERCIAL", "PUBLIC_GOVERNMENT_BUMN"], "default": "PRIVATE_COMMERCIAL" },
                  "capRatio": { "type": "number", "default": 120.0 },
                  "perspectives": { "type": "array" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Balanced Scorecard evaluation successful" },
          "400": { "description": "Invalid input parameters" }
        }
      }
    },
    "/api/v1/strategy/qspm": {
      "post": {
        "summary": "Quantitative Strategic Planning Matrix (QSPM) Evaluation",
        "description": "Evaluates alternative strategic choices by computing Total Attractiveness Scores (TAS) from IFE/EFE factor weights and Attractiveness Scores.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["factors", "strategies"],
                "properties": {
                  "factors": { "type": "array" },
                  "strategies": { "type": "array" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "QSPM evaluation successful" },
          "400": { "description": "Invalid input parameters" }
        }
      }
    },
    "/api/v1/commerce/rop-safety-stock": {
      "post": {
        "summary": "Calculate Reorder Point & Stochastic Safety Stock",
        "description": "Computes Safety Stock and Reorder Point (ROP) with Z-score service level tables under demand and lead-time variability.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["averageDailyDemand", "leadTimeDays"],
                "properties": {
                  "averageDailyDemand": { "type": "number", "example": 50 },
                  "leadTimeDays": { "type": "number", "example": 10 },
                  "demandStdDev": { "type": "number", "example": 5 },
                  "leadTimeStdDev": { "type": "number", "example": 1 },
                  "serviceLevelPercent": { "type": "number", "example": 95.0 },
                  "currentStock": { "type": "number", "example": 600 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ROP calculation successful" },
          "400": { "description": "Invalid input parameters" }
        }
      }
    },
    "/api/v1/finance/inventory-valuation": {
      "post": {
        "summary": "Inventory Valuation: FIFO vs Moving Weighted Average",
        "description": "Performs stock card costing per Article 10(6) UU PPh & PSAK 14, computing ending inventory value, COGS, and statutory 22% corporate tax delta.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["transactions"],
                "properties": {
                  "beginningInventory": { "type": "object" },
                  "transactions": { "type": "array" },
                  "corporateTaxRate": { "type": "number", "default": 0.22 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Inventory valuation successful" },
          "400": { "description": "Invalid input parameters" }
        }
      }
    },
    "/api/v1/finance/ecl-provision": {
      "post": {
        "summary": "PSAK 71 Expected Credit Loss (ECL) Receivables Impairment",
        "description": "Calculates trade receivables impairment provision matrix, net carrying value, journal entries, and non-deductible fiscal correction under Article 9(1)(c) UU PPh.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agingSchedule": { "type": "object" },
                  "buckets": { "type": "array" },
                  "existingAllowanceBalance": { "type": "number", "default": 0 },
                  "macroAdjustmentFactor": { "type": "number", "default": 1.0 },
                  "isFinancialInstitution": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ECL provisioning calculation successful" },
          "400": { "description": "Invalid input parameters" }
        }
      }
    }
  }
}
